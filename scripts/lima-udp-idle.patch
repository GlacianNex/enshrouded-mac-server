-func (g *GrpcClientRW) SetReadDeadline(_ time.Time) error {
-	return nil
+func (g *GrpcClientRW) SetReadDeadline(deadline time.Time) error {
+	if g.protocol != "udp" {
+		return nil
+	}
+	g.deadlineMu.Lock()
+	defer g.deadlineMu.Unlock()
+	g.deadlineGeneration++
+	generation := g.deadlineGeneration
+	if g.deadlineTimer != nil {
+		g.deadlineTimer.Stop()
+		g.deadlineTimer = nil
+	}
+	if g.deadlineClosed || deadline.IsZero() {
+		return nil
+	}
+	g.deadlineTimer = time.AfterFunc(time.Until(deadline), func() {
+		g.expireUDPDeadline(generation)
+	})
+	return nil
+}
+
+func (g *GrpcClientRW) expireUDPDeadline(generation uint64) {
+	g.deadlineMu.Lock()
+	defer g.deadlineMu.Unlock()
+	// Stop cannot retract an already-running callback. A superseded timer
+	// must never cancel traffic whose deadline was refreshed or cleared.
+	if !g.deadlineClosed && generation == g.deadlineGeneration {
+		g.deadlineClosed = true
+		g.deadlineTimer = nil
+		g.cancel()
+	}
+}
+
+func (g *GrpcClientRW) cancelStream() {
+	g.deadlineMu.Lock()
+	defer g.deadlineMu.Unlock()
+	g.deadlineClosed = true
+	if g.deadlineTimer != nil {
+		g.deadlineTimer.Stop()
+		g.deadlineTimer = nil
+	}
+	g.cancel()
 }
 
